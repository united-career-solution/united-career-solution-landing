# SQLite database file path (relative to the application working directory)
SQLITE_PATH=./website.sqlite

# Required only for the one-time migration
MONGODB_URI=mongodb://localhost:27017/website_backend

# Secret used to sign admin login tokens
JWT_SECRET=change-me

# Admin account created on first DB connection if no admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
